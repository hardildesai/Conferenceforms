# Path to your Excel file (.xlsx, .xls, or .csv)
EXCEL_FILE_PATH=contacts.xlsx

# Optional: Specific sheet name (leave empty to use the first sheet)
EXCEL_SHEET_NAME=

# Optional: Column header name for target phone number (auto-detected if blank)
PHONE_COLUMN=

# Delay range between consecutive WhatsApp messages (milliseconds)
MIN_DELAY_MS=15000
MAX_DELAY_MS=45000

# Set to true to resend to ALL rows regardless of WhatsApp_Status
SEND_TO_ALL=false

# Auto-generate & send QR code image if a 'code' or 'Code' column is present
GENERATE_QR_CODE=true

# Optional: Path to a custom attachment image or file (e.g. poster.jpg, invitation.png, brochure.pdf)
# The text from template.txt will be attached as the CAPTION underneath this image!
ATTACHMENT_FILE_PATH=

