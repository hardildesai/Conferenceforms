# WhatsApp Sender — Environment Variables
# Copy to .env and fill in your values before running the script.
# NEVER commit .env to version control.

# Supabase connection (use the service-role key — not the anon key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: delay range in milliseconds (defaults: 20000–90000)
# MIN_DELAY_MS=20000
# MAX_DELAY_MS=90000
